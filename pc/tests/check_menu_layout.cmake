# ctest "menu_layout": the new menu's tree (src/host/menu_layout.c, docs/MENUS.md) places every row of the settings
# table (src/host/settings.c g_settings[]) exactly once (ML_SET, or ML_MERGED into a GAME SETUP row) or retires it
# (ML_RETIRED), and every shortcut (ML_SHORTCUT) names a real row. GAME SETUP > BIORAND places every BioRand generator
# option (src/host/biorand_opts.c, but its ENEMIES group: BioRand changes no enemy of this game) exactly once (ML_BIO),
# and the presets (menu_setup_owned, menu_remix, menu_chaos) name real rows. A new setting or BioRand option without a
# home in the new menu fails. No game code is linked.
#   cmake -DSRC=<pc dir> -P check_menu_layout.cmake
#   -DSELFTEST=1: the same check on broken copies (a row dropped, a row twice, a shortcut to nothing) must fail
function(menu_layout_check table layout out)
    string(REGEX MATCHALL "{ SP_[A-Z]+, \"[^\"]+\"" rows "${table}")
    string(REGEX MATCHALL "ML_(SET|RETIRED|SHORTCUT|MERGED), \"[^\"]+\"" placed "${layout}")
    set(labels "")
    foreach(r ${rows})
        string(REGEX REPLACE "{ SP_[A-Z]+, \"([^\"]+)\"" "\\1" l "${r}")
        list(APPEND labels "${l}")
    endforeach()
    set(homes "")
    set(errors "")
    foreach(p ${placed})
        string(REGEX REPLACE "ML_([A-Z]+), \"([^\"]+)\"" "\\1" kind "${p}")
        string(REGEX REPLACE "ML_([A-Z]+), \"([^\"]+)\"" "\\2" l "${p}")
        list(FIND labels "${l}" at)
        if(at EQUAL -1)
            list(APPEND errors "'${l}' (${kind}) is no row of the settings table")
        elseif(NOT kind STREQUAL "SHORTCUT")
            list(FIND homes "${l}" twice)
            if(NOT twice EQUAL -1)
                list(APPEND errors "'${l}' is placed twice")
            endif()
            list(APPEND homes "${l}")
        endif()
    endforeach()
    foreach(l ${labels})
        list(FIND homes "${l}" at)
        if(at EQUAL -1)
            list(APPEND errors "'${l}' has no home")
        endif()
    endforeach()
    list(LENGTH labels n)
    if(n LESS 100)
        list(APPEND errors "only ${n} settings-table rows found in settings.c; update this check")
    endif()
    set(${out} "${errors}" PARENT_SCOPE)
endfunction()

# BioRand's options by key (biorand_opts.c's macros: FLAG(group, field, RANGE(group, type, field, ROW("key", group, WEAPON(i,
# ENEMY(i) and GAME SETUP's ML_BIO rows; the presets' labels
function(menu_bio_check opts layout table out)
    set(keys "")
    string(REGEX MATCHALL "(FLAG\\(BOG_[A-Z]+, [A-Za-z0-9]+|RANGE\\(BOG_[A-Z]+, BO_[A-Z]+, [A-Za-z0-9]+|ROW\\(\"[A-Za-z0-9]+\", BOG_[A-Z]+|WEAPON\\([0-9]+)" found "${opts}")
    foreach(f ${found})
        if(f MATCHES "BOG_ENEMIES")
            continue()
        elseif(f MATCHES "^WEAPON\\(([0-9]+)")
            list(APPEND keys "EnabledWeapons[${CMAKE_MATCH_1}]")
        elseif(f MATCHES "^ROW\\(\"([A-Za-z0-9]+)\"")
            list(APPEND keys "${CMAKE_MATCH_1}")
        elseif(f MATCHES "([A-Za-z0-9]+)$")
            list(APPEND keys "${CMAKE_MATCH_1}")
        endif()
    endforeach()
    string(REGEX MATCHALL "ML_BIO, \"[^\"]+\"" placed "${layout}")
    set(homes "")
    set(errors "")
    foreach(p ${placed})
        string(REGEX REPLACE "ML_BIO, \"([^\"]+)\"" "\\1" k "${p}")
        list(FIND keys "${k}" at)
        list(FIND homes "${k}" twice)
        if(at EQUAL -1)
            list(APPEND errors "'${k}' (ML_BIO) is no BioRand option outside ENEMIES")
        elseif(NOT twice EQUAL -1)
            list(APPEND errors "BioRand option '${k}' is placed twice")
        endif()
        list(APPEND homes "${k}")
    endforeach()
    foreach(k ${keys})
        list(FIND homes "${k}" at)
        if(at EQUAL -1)
            list(APPEND errors "BioRand option '${k}' has no home")
        endif()
    endforeach()
    list(LENGTH keys n)
    if(n LESS 25)
        list(APPEND errors "only ${n} BioRand options found in biorand_opts.c; update this check")
    endif()
    string(REGEX MATCHALL "{ SP_[A-Z]+, \"[^\"]+\"" rows "${table}")
    set(labels "")
    foreach(r ${rows})
        string(REGEX REPLACE "{ SP_[A-Z]+, \"([^\"]+)\"" "\\1" l "${r}")
        list(APPEND labels "${l}")
    endforeach()
    string(REGEX MATCH "menu_setup_owned\\[\\] = {[^;]*;" owned "${layout}")
    string(REGEX MATCH "menu_remix\\[\\] = {[^;]*;" remix "${layout}")
    string(REGEX MATCH "menu_chaos\\[\\] = {[^;]*;" chaos "${layout}")
    string(REGEX MATCHALL "\"[^\"]+\"" refs "${owned}${remix}${chaos}")
    if(NOT owned OR NOT remix OR NOT chaos)
        list(APPEND errors "the GAME SETUP presets (menu_setup_owned, menu_remix, menu_chaos) are not found")
    endif()
    foreach(r ${refs})
        string(REPLACE "\"" "" l "${r}")
        list(FIND labels "${l}" at)
        if(at EQUAL -1)
            list(APPEND errors "preset row '${l}' is no row of the settings table")
        endif()
    endforeach()
    set(${out} "${errors}" PARENT_SCOPE)
endfunction()

file(READ "${SRC}/src/host/settings.c" table)
file(READ "${SRC}/src/host/menu_layout.c" layout)
file(READ "${SRC}/src/host/biorand_opts.c" opts)
menu_layout_check("${table}" "${layout}" errors)
menu_bio_check("${opts}" "${layout}" "${table}" bio_errors)
list(APPEND errors ${bio_errors})
if(errors)
    string(REPLACE ";" "\n  " errors "${errors}")
    message(FATAL_ERROR "menu_layout: src/host/menu_layout.c does not match the settings table:\n  ${errors}\n"
                        "Give each row of g_settings[] exactly one home (ML_SET) or retire it (ML_RETIRED); docs/MENUS.md.")
endif()
string(REGEX MATCHALL "{ SP_[A-Z]+, \"" rows "${table}")
list(LENGTH rows n)
message(STATUS "menu_layout: all ${n} settings-table rows and the BioRand options placed once")

if(SELFTEST)
    # a row dropped
    string(REGEX REPLACE "ML_SET, \"Fast Loading\"" "ML_PAGE, NULL" broken "${layout}")
    menu_layout_check("${table}" "${broken}" e1)
    # a row twice
    string(REPLACE "ML_SET, \"Quick Knife\" }," "ML_SET, \"Quick Knife\" }, { 0, NULL, ML_SET, \"Quick Knife\" }," broken "${layout}")
    menu_layout_check("${table}" "${broken}" e2)
    # a shortcut to nothing
    string(REPLACE "ML_SHORTCUT, \"Headshots & Piercing\"" "ML_SHORTCUT, \"Headshots and Piercing\"" broken "${layout}")
    menu_layout_check("${table}" "${broken}" e3)
    # a BioRand option dropped, an unknown key, a preset naming nothing
    string(REPLACE "ML_BIO, \"HiddenKeyItems\"" "ML_PAGE, NULL" broken "${layout}")
    menu_bio_check("${opts}" "${broken}" "${table}" e4)
    string(REPLACE "ML_BIO, \"AreaSize\"" "ML_BIO, \"EnemyQuantity\"" broken "${layout}")
    menu_bio_check("${opts}" "${broken}" "${table}" e5)
    string(REPLACE "{ \"Rearranged Enemies\", 1 }" "{ \"Rearranged Enemy\", 1 }" broken "${layout}")
    menu_bio_check("${opts}" "${broken}" "${table}" e6)
    if(NOT e1 MATCHES "Fast Loading' has no home" OR NOT e2 MATCHES "Quick Knife' is placed twice" OR NOT e3 MATCHES "is no row"
       OR NOT e4 MATCHES "HiddenKeyItems' has no home" OR NOT e5 MATCHES "EnemyQuantity' \\(ML_BIO\\) is no BioRand" OR NOT e6 MATCHES "Rearranged Enemy' is no row")
        message(FATAL_ERROR "menu_layout self-test: a broken layout passed (${e1} | ${e2} | ${e3} | ${e4} | ${e5} | ${e6})")
    endif()
    message(STATUS "menu_layout self-test: a dropped row, a duplicate, a bad shortcut, a missing or unknown BioRand option and a bad preset row are caught")
endif()
