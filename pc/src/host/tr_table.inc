{ "Auto-climb Stairs", { "Montée auto des escaliers", "Treppen automatisch steigen", "Subir escaleras automáticamente", "階段の自動昇降", "Автоподъём по лестницам" } },
{ "Automatic", { "Automatique", "Automatisch", "Automático", "自動", "Автоматически" } },
