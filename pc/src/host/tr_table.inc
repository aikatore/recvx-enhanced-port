{ "Connected to %s. Ping: %d ms. %s is in area %d, room %d%s", { "Connecté à %s. Ping : %d ms. %s est en zone %d, salle %d%s", "Mit %s verbunden. Ping: %d ms. %s ist in Bereich %d, Raum %d%s", "Conectado a %s. Ping: %d ms. %s está en el área %d, habitación %d%s", "%s に接続中。Ping: %d ms。%s はエリア %d、部屋 %d%s", "Подключено к %s. Пинг: %d мс. %s в зоне %d, комната %d%s", "Bağlanılan: %s. Ping: %d ms. %s: bölge %d, oda %d%s", "Conectado a %s. Ping: %d ms. %s está na área %d, sala %d%s" } },
{ "Connected to %s. Ping: %d ms. Partner has not entered the game.", { "Connecté à %s. Ping : %d ms. Le partenaire n'est pas encore en jeu.", "Mit %s verbunden. Ping: %d ms. Der Partner ist noch nicht im Spiel.", "Conectado a %s. Ping: %d ms. El compañero no ha entrado en la partida.", "%s に接続中。Ping: %d ms。パートナーはまだゲームに入っていません。", "Подключено к %s. Пинг: %d мс. Напарник ещё не вошёл в игру.", "Bağlanılan: %s. Ping: %d ms. Partner henüz oyuna girmedi.", "Conectado a %s. Ping: %d ms. O parceiro ainda não entrou no jogo." } },
