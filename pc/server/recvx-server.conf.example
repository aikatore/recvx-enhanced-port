# recvx-server configuration (docs/SERVER.md "Configuration").
#
# Install as /etc/recvx-server.conf (read at start when it exists) or pass --config PATH (the
# systemd user unit reads ~/recvx-server/recvx-server.conf).
# Format: one "key = value" per line; '#' or ';' starts a comment; no sections. Unknown keys are
# reported and ignored; an invalid value stops the server from starting. Every key is also a
# command-line flag (--relay-kb-per-sec 1024), and flags win over this file.
# Reload: SIGHUP applies the limits, log_level and stats_interval at once; port, listen,
# max_rooms and control need a restart. A file with errors on reload is refused and the running
# settings stay. With a control socket, `systemctl --user reload recvx-server` (--take-over)
# applies the whole file except port, listen and control, without dropping a session.
#
# All values below are the defaults: this file as it is changes nothing.

# --- network ---------------------------------------------------------------------------------

# UDP port the games connect to (open it in the firewall). The environment variable
# RECVX_SERVER_PORT overrides this file, --port overrides both.
port = 7141

# Local IPv4 address(es) to listen on, comma-separated (at most 8). 0.0.0.0 = all addresses.
# A server with several public addresses should list them: replies then leave from the address
# each game talked to, which NATs require. IPv6 is not supported yet.
listen = 0.0.0.0

# --- rooms -------------------------------------------------------------------------------------

# Open rooms at once (1..65535). Each costs ~300 bytes of memory. Restart to change.
max_rooms = 1024

# Open rooms one IP address may host at once (several players behind one router each host one).
rooms_per_ip = 4

# Seconds without the host's keepalive before its room closes. The games send one every 1-3 s;
# a host killed without leaving keeps its room (and code) this long.
room_timeout = 30

# Seconds without the joining player's keepalive (every 3 s) or relayed traffic before its place
# in the room is free again, so a partner whose game crashed can join again. The same player
# joining again (its rejoin tag) takes its place at once, and the host can remove it ("Remove
# stuck player"); this is for everyone else. At least 6 (two keepalives may be lost).
member_timeout = 10

# Seconds a closed room's code is not handed out again, so a late joiner never lands in a
# newer room with an old code.
code_grace = 120

# --- abuse limits (per IP address) -------------------------------------------------------------

# Requests (HELLO, CREATE, JOIN, KEEPALIVE, CLOSE, KICK) per address and second; bursts of 2 s worth.
# Relayed game traffic does not count here (see relay_*). Over it: dropped, logged once per 10 s.
requests_per_sec = 20

# Failed joins (unknown room code, wrong password) per address and minute; then its joins are
# refused for the rest of the minute. Guards the room codes and passwords against guessing.
failed_joins_per_min = 5

# Rooms an address may open per minute (CREATE; a retry of the same request does not count). A game
# opens one per lobby; opening and closing rooms in a loop would fill the closed codes' grace table.
rooms_per_ip_per_min = 6

# --- abuse limits (all addresses together) -----------------------------------------------------

# Requests per second from all addresses together: caps the replies a flood from many (or
# spoofed) addresses can get. Far above what real games need (~1 a second each).
requests_total_per_sec = 5000

# Failed joins per minute from all addresses together: room-code guessing with many addresses.
# When it is used up, joins wait for the next minute (also correct ones). After 10 wrong passwords
# within a minute, a room slows down addresses that already failed (a short gap between their
# tries); addresses without failures are always checked, so there is no lockout.
failed_joins_total_per_min = 600

# --- relay limits ------------------------------------------------------------------------------
# Measured game traffic (RECVX_COOP_STATS, docs/SERVER.md "Sizing the relay"): a busy host
# sends ~3.6 KB in 4-5 datagrams per frame at 30 frames/s (~110 KB/s, ~135 datagrams/s); the
# worst case seen (extra enemies, 48 snapshots, room loads, joins) stays below ~170 KB/s and
# ~200 datagrams/s. The defaults leave ~3x headroom. Each player has its own budget (a bucket
# that holds one second's worth, so short bursts pass); datagrams over it are dropped (the game
# resends what matters) and the room is logged once per 10 s.

# Relay bandwidth per player, KB/s (1 KB = 1024 bytes), counted as the UDP payload.
relay_kb_per_sec = 512

# Relayed datagrams per player and second.
relay_datagrams_per_sec = 600

# Per IP address, all its players and rooms together. This budget outlives rooms and
# memberships, so leaving and joining again (or opening a new room) does not refill it. Fits two
# busy players behind one router (or ~6 hosts); raise it for LAN parties relayed from one address.
relay_address_kb_per_sec = 1024
relay_address_datagrams_per_sec = 1200

# All relayed traffic of the server together: the production safety cap for the bandwidth bill
# and the line. 25600 KB/s = 25 MB/s, ~210 Mbit/s each way, ~150 busy relayed rooms. 0 = no limit.
relay_total_kb_per_sec = 25600
relay_total_datagrams_per_sec = 50000

# --- logging and metrics -----------------------------------------------------------------------

# normal: start, errors, rooms opened/closed, limit hits. verbose: also every request, join
# and the relay starting/stopping per room, with addresses truncated to /24 (normal mode logs
# no addresses at all). Never logged: passwords, verifiers, keys, tokens, game data, full room
# codes. All event lines share a budget of 20 a second (bursts of 200); the rest is counted.
# "verbose = yes" or the flag -v / --verbose do the same as log_level = verbose.
log_level = normal

# Seconds between one-line metrics summaries in the log (0 = off). The full metrics are also
# available any time from the server machine: recvx-client 127.0.0.1 status (or status-json)
stats_interval = 300

# --- updates -----------------------------------------------------------------------------------

# A unix socket (an absolute path; created with mode 0600, so only the server's own user can use
# it) through which a new version takes the running server over without dropping a session
# (recvx-server --take-over), or the server is told to drain (recvx-server --drain). Empty = none.
# Restart to change. docs/SERVER.md "Updating without dropping sessions".
# Example: control = /home/recvx/recvx-server/control.sock
control =
